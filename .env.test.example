# Test Database
TEST_DATABASE_URL="ppostgresql://<username>:<password>@<host>:<port>/helpdesk_test?schema=public"

# Development Database (for E2E tests running against dev DB)
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/helpdesk?schema=public"

# Better Auth
# Generate secret: openssl rand -base64 32
# IMPORTANT: Use a strong, unique secret in production (min 32 characters)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# Trusted Origins
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3001"

# Server Port
PORT=3001

# Environment
NODE_ENV=test

# Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="TestPassword123!"

# Agent User (for E2E tests)
AGENT_EMAIL=agent@example.com
AGENT_PASSWORD="TestPassword123!"
