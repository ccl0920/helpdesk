# Database
# Test database - automatically created/dropped during test runs
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/helpdesk?schema=public"
TEST_DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/helpdesk_test?schema=public"

# Better Auth
# Generate secret: openssl rand -base64 32
# IMPORTANT: Use a strong, unique secret in production (min 32 characters)
BETTER_AUTH_SECRET="test-secret-key-for-e2e-testing-only-do-not-use-in-production"
BETTER_AUTH_URL="http://localhost:3001"

# Trusted Origins (comma-separated list of allowed frontend URLs)
# CSRF protection will only accept requests from these origins
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:3001"

# Server Port
PORT=3001

# Environment (test mode)
NODE_ENV=test

# Admin User (for seed script)
# IMPORTANT: Use strong, unique credentials in production
# Password must be at least 12 characters with uppercase, lowercase, number, and special character
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="Admin123!@#test"
