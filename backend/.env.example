# Database
# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/helpdesk?schema=public"

# Better Auth
# Generate secret: openssl rand -base64 32
# IMPORTANT: Use a strong, unique secret in production (min 32 characters)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# Trusted Origins (comma-separated list of allowed frontend URLs)
# CSRF protection will only accept requests from these origins
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:3001"

# Server Port
PORT=3001

# Environment (optional, defaults to development)
# Set to 'production' in production environments for stricter security
NODE_ENV=development

# Sentry Error Tracking (optional)
# Set to enable backend error reporting and performance monitoring
SENTRY_DSN=""

# Admin User (for seed script)
# IMPORTANT: Use strong, unique credentials in production
# Password must be at least 12 characters with uppercase, lowercase, number, and special character
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=""