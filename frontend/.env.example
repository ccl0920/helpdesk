# Frontend Environment Variables

# API Base URL
# In development, this is proxied through Vite dev server
# In production, set to your backend API URL
VITE_API_URL=http://localhost:3001

# Sentry Error Tracking (optional)
# Set to enable frontend error reporting and session replay
VITE_SENTRY_DSN=""

# Sentry Source Maps Upload (optional, used during build)
# Required for uploading source maps to Sentry
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Server Port (configured in vite.config.ts)
# Default: 5173 (development), 5174 (tests via PORT env var)

